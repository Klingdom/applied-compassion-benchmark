certbot/
nginx-active.conf

# Pipeline runtime state (297KB rewritten each run, bad for git history)
# The scan files already record what was processed each night for auditability
research/rotation-state.json
research/rotation-state.json.tmp

# Build artifacts
site/.next/
site/out/

# Dependencies (worker/ has no local .gitignore; site/ is covered by site/.gitignore)
node_modules/

# Pipeline temp files
research/logs/
tmp/
*.tmp

# Agent scratch generators (date-stamped, created per-run, never part of the pipeline)
# Prevents a careless `git add -A` sweeping them into history.
# See the prior cleanup commit "Remove agent scratch files committed by mistake".
research/scripts/*_2026_*
research/scripts/*_2027_*
research/scripts/_tmp_*
research/scripts/.gen-results-*.json
